pragma language_version >= 0.23;
import CompactStandardLibrary;
export ledger willCommit: Bytes<32>;
export ledger beneficiaryRoot: Bytes<32>;
export ledger version: Counter;
witness ownerSecret(): Bytes<32>;
witness oldWill(): Bytes<32>;
witness newWill(): Bytes<32>;
witness newRoot(): Bytes<32>;
export circuit updateWill(): [] {
  const sk = ownerSecret();
  assert(willCommit == disclose(persistentHash<Vector<2, Bytes<32>>>([sk, oldWill()])), "not owner");
  willCommit      = disclose(persistentHash<Vector<2, Bytes<32>>>([sk, newWill()]));
  beneficiaryRoot = disclose(newRoot());
  version.increment(1);
}
