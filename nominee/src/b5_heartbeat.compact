pragma language_version >= 0.23;
import CompactStandardLibrary;
export ledger willCommit: Bytes<32>;
export ledger lastSeen: Uint<64>;
witness ownerSecret(): Bytes<32>;
witness willContents(): Bytes<32>;
export circuit heartbeat(now: Uint<64>): [] {
  const sk = ownerSecret();
  const w  = willContents();
  const c  = persistentHash<Vector<2, Bytes<32>>>([sk, w]);
  assert(willCommit == disclose(c), "not the owner / will changed");
  assert(blockTimeGte(disclose(now)), "now is in the future");
  lastSeen = disclose(now);
}
