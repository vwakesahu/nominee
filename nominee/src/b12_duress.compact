pragma language_version >= 0.23;
import CompactStandardLibrary;
// Both commitments live on ledger. The PIN decides which one the owner is
// proving against. The circuit must not reveal which.
export ledger realCommit:  Bytes<32>;
export ledger decoyCommit: Bytes<32>;
export ledger activeRoot:  Bytes<32>;
export ledger resolved:    Boolean;

witness ownerSecret(): Bytes<32>;
witness pin(): Uint<16>;
witness willContents(): Bytes<32>;
witness rootForThisWill(): Bytes<32>;

export circuit resolveUnderPin(): [] {
  const sk = ownerSecret();
  const p  = pin();
  const c  = persistentHash<Vector<3, Bytes<32>>>([sk, persistentHash<Uint<16>>(p), willContents()]);
  // matches EITHER commitment — circuit does not say which
  const isReal  = (c == realCommit);
  const isDecoy = (c == decoyCommit);
  assert(disclose(isReal || isDecoy), "bad pin");
  activeRoot = disclose(rootForThisWill());
  resolved   = true;
}
