# dependencies
node_modules/

# generated Compact output — regenerate with `compact compile +0.31.1`
managed/
out/
**/managed-a2/

# ...EXCEPT the product contract's build, which is committed on purpose so a
# judge can run the CLI without installing the Compact toolchain.
!contract/out/
!contract/out/**

# proving keys are large and reproducible — except the product contract's
*.prover
*.verifier
keys/
!contract/out/keys/
!contract/out/keys/*.prover
!contract/out/keys/*.verifier

# third-party repositories cloned for prior-art review.
# These are other people's code with their own git history and licences.
# Re-clone with the list in VALIDATION_NOMINEE.md / VALIDATION_REPORT.md.
priorart/

# local run artifacts
*.log
a1-results.json
a1-hold-results.json
.DS_Store

# local devnet funding config (contains test mnemonics)
accounts.json

# third-party minified bundle, downloaded only to extract the AKINDO API path.
# The extracted evidence is raw/wavehack.json.
raw/pages__app-*.js
raw/pages_wave-hacks*.js
raw/akindo_page.html

# generated ZKIR from calibration runs
**/out_*/

