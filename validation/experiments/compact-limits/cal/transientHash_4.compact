pragma language_version >= 0.26;
import CompactStandardLibrary;
export ledger sink: Bytes<32>;
export circuit f(x: Bytes<32>): [] {
  const h0 = x;
  const h1 = transientHash<Bytes<32>>(h0);
  const h2 = transientHash<Field>(h1);
  const h3 = transientHash<Field>(h2);
  const h4 = transientHash<Field>(h3);
  sink.write(disclose(persistentHash<Field>(h4)));
}
