pragma language_version >= 0.23;
import CompactStandardLibrary;
// The court's envelope is encrypted CLIENT-SIDE (no in-circuit encryption on 0.31.1).
// What IS provable in-circuit: that the plaintext behind the published ciphertext
// commitment equals the values the contract already committed to.
export ledger vaultCommit:    Bytes<32>;   // commitment to (totalValue, executorId)
export ledger envelopeCommit: Bytes<32>;   // commitment to the ciphertext handed to the court
export ledger probateOpened:  Boolean;

witness totalValue():  Uint<128>;
witness executorId():  Bytes<32>;
witness blinding():    Bytes<32>;
witness ciphertext():  Bytes<32>;   // hash/commitment of the client-side ciphertext

export circuit openProbate(): [] {
  const v  = totalValue();
  const ex = executorId();
  const b  = blinding();
  // same commitment the contract holds
  const c = persistentHash<Vector<3, Bytes<32>>>([persistentHash<Uint<128>>(v), ex, b]);
  assert(vaultCommit == disclose(c), "values do not match the vault commitment");
  // bind the envelope to those same values
  const ec = persistentHash<Vector<2, Bytes<32>>>([ciphertext(), c]);
  envelopeCommit = disclose(ec);
  probateOpened  = true;
}
