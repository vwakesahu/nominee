pragma language_version >= 0.23;
import CompactStandardLibrary;
import "schnorr" prefix Schnorr_;
export ledger guardians: Map<Uint<16>, JubjubPoint>;
export ledger resolved: Boolean;
export ledger deathAttested: Counter;
witness gSig0(): Schnorr_SchnorrSignature;
witness gSig1(): Schnorr_SchnorrSignature;
witness gSig2(): Schnorr_SchnorrSignature;
export circuit resolveEarly(gid0: Uint<16>, gid1: Uint<16>, gid2: Uint<16>): [] {
  const msg: Vector<4, Field> = [1 as Field, 0 as Field, 0 as Field, 0 as Field];
  assert(guardians.member(disclose(gid0)), "unknown guardian");
  Schnorr_schnorrVerify<4>(msg, gSig0(), guardians.lookup(disclose(gid0)));
  assert(guardians.member(disclose(gid1)), "unknown guardian");
  Schnorr_schnorrVerify<4>(msg, gSig1(), guardians.lookup(disclose(gid1)));
  assert(guardians.member(disclose(gid2)), "unknown guardian");
  Schnorr_schnorrVerify<4>(msg, gSig2(), guardians.lookup(disclose(gid2)));
  assert(disclose(gid0) < disclose(gid1), "ids must strictly increase");
  assert(disclose(gid1) < disclose(gid2), "ids must strictly increase");
  resolved = true;
  deathAttested.increment(1);
}
