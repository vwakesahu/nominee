{
  "name": "nominee",
  "version": "0.1.0",
  "private": true,
  "description": "Add a nominee to your crypto. Nobody learns who.",
  "homepage": "https://nominee.world",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "contract",
    "cli",
    "test",
    "server",
    "web"
  ],
  "scripts": {
    "compact": "cd contract && compact compile +0.31.1 src/nominee.compact out",
    "build": "bun run --cwd cli build",
    "leakcheck": "python3 test/privacy/leakcheck.py contract/out/zkir",
    "leaktest": "python3 test/privacy/leaktest.py",
    "test": "bun run --cwd test test",
    "demo": "node cli/bin/nominee.mjs demo",
    "deploy": "NODE_OPTIONS=--max-old-space-size=8192 node cli/bin/nominee.mjs deploy",
    "address": "node cli/bin/nominee.mjs address",
    "doctor": "node cli/bin/nominee.mjs doctor",
    "nominee": "node cli/bin/nominee.mjs",
    "web": "bun run --cwd web dev",
    "server": "bun run --cwd cli build && bun run --cwd server build && node server/dist/index.js"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "packageManager": "bun@1.4.0"
}
