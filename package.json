{
  "name": "nominee",
  "version": "0.1.0",
  "private": true,
  "description": "Add a nominee to your crypto. Nobody learns who.",
  "homepage": "https://nominee.world",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "contract",
    "cli",
    "test",
    "web"
  ],
  "scripts": {
    "compact": "cd contract && compact compile +0.31.1 src/nominee.compact out",
    "build": "bun run --cwd cli build",
    "leakcheck": "python3 test/privacy/leakcheck.py contract/out/zkir",
    "leaktest": "python3 test/privacy/leaktest.py",
    "test": "bun run --cwd test test",
    "demo": "bun run build && node cli/dist/index.js demo",
    "nominee": "node cli/dist/index.js",
    "web": "bun run --cwd web dev"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "packageManager": "bun@1.4.0"
}
