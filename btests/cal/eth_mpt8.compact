  const n1 = node1();
  const h1 = keccak256<Bytes<532>>(n1);
  const n2 = node2();
  const h2 = keccak256<Bytes<532>>(n2);
  const n3 = node3();
  const h3 = keccak256<Bytes<532>>(n3);
  const n4 = node4();
  const h4 = keccak256<Bytes<532>>(n4);
  const n5 = node5();
  const h5 = keccak256<Bytes<532>>(n5);
  const n6 = node6();
  const h6 = keccak256<Bytes<532>>(n6);
  const n7 = node7();
  const h7 = keccak256<Bytes<532>>(n7);
  const acc = h0;
  const c1 = keccak256<Bytes<32>>(h1);
  const c2 = keccak256<Bytes<32>>(h2);
  const c3 = keccak256<Bytes<32>>(h3);
  const c4 = keccak256<Bytes<32>>(h4);
  const c5 = keccak256<Bytes<32>>(h5);
  const c6 = keccak256<Bytes<32>>(h6);
  const c7 = keccak256<Bytes<32>>(h7);
  out.write(disclose(h0));
