witness node2(): Bytes<532>;
witness node3(): Bytes<532>;
witness node4(): Bytes<532>;
witness node5(): Bytes<532>;
witness node6(): Bytes<532>;
witness node7(): Bytes<532>;
export circuit verifyStorageProof(): [] {
  const r0 = stateRoot;
  const n0 = node0();
