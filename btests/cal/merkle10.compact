pragma language_version >= 0.26;
import CompactStandardLibrary;

export ledger commitments: MerkleTree<10, Bytes<32>>;
export ledger nullifiers: Set<Bytes<32>>;

witness findPath(cm: Bytes<32>): MerkleTreePath<10, Bytes<32>>;
witness secret(): Bytes<32>;

export circuit proveMembership(): [] {
  const s = secret();
  const cm = persistentHash<Bytes<32>>(s);
  const path = findPath(cm);
  // verify membership against the on-ledger root
  assert(commitments.checkRoot(merkleTreePathRoot<10, Bytes<32>>(path)), "not a member");
  const nf = persistentHash<Bytes<32>>(s);
  nullifiers.insert(disclose(nf));
}
