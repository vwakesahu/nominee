pragma language_version >= 0.23;
import CompactStandardLibrary;
// "mid-size": 10 hash calls + Merkle membership (depth 20)
export ledger tree: MerkleTree<20, Bytes<32>>;
export ledger nulls: Set<Bytes<32>>;
witness secret(): Bytes<32>;
witness path(cm: Bytes<32>): MerkleTreePath<20, Bytes<32>>;
export circuit midsize(): [] {
  const s = secret();
  const h1 = persistentHash<Bytes<32>>(s);
  const h2 = persistentHash<Bytes<32>>(h1);
  const h3 = persistentHash<Bytes<32>>(h2);
  const h4 = persistentHash<Bytes<32>>(h3);
  const h5 = persistentHash<Bytes<32>>(h4);
  const h6 = persistentHash<Bytes<32>>(h5);
  const h7 = persistentHash<Bytes<32>>(h6);
  const h8 = persistentHash<Bytes<32>>(h7);
  const h9 = persistentHash<Bytes<32>>(h8);
  const h10 = persistentHash<Bytes<32>>(h9);
  const p = path(h10);
  assert(tree.checkRoot(disclose(merkleTreePathRoot<20, Bytes<32>>(p))), "not member");
  nulls.insert(disclose(h10));
}
